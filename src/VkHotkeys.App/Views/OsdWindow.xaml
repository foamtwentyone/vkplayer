<Window x:Class="VkHotkeys.App.Views.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VK Hotkeys OSD"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        IsHitTestVisible="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        Opacity="0">
    <Border x:Name="Card" CornerRadius="14" Padding="16,12" Margin="8"
            Background="#EE1C1F24" BorderBrush="#33FFFFFF" BorderThickness="1"
            MinWidth="280" MaxWidth="420">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.45" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource AccentBrush}" x:Name="IconBack"
                    VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock x:Name="Glyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Text="&#xE8D6;" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" Foreground="#FFF2F3F5"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SubtitleText" FontSize="13" Foreground="#FFA8AFB8" Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis" />
                <ProgressBar x:Name="Bar" Height="4" Margin="0,8,0,2" Minimum="0" Maximum="100"
                             Visibility="Collapsed" Style="{StaticResource ThinProgress}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
